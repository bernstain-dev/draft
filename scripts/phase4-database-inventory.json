      "definition": "CHECK ((((slot_duration_minutes >= 1) AND (slot_duration_minutes <= 1440)) AND (start_time < end_time) AND (EXTRACT(second FROM start_time) = (0)::numeric) AND (EXTRACT(second FROM end_time) = (0)::numeric) AND (((slot_duration_minutes * (60)::bigint))::numeric <= EXTRACT(epoch FROM (end_time - start_time)))))"
    },
    {
      "name": "phase2_schedule_no_overlap",
      "table": "doctor_schedules",
      "definition": "EXCLUDE USING gist (doctor_id WITH =, day_of_week WITH =, int4range(((EXTRACT(epoch FROM start_time) / (60)::numeric))::integer, ((EXTRACT(epoch FROM end_time) / (60)::numeric))::integer, '[)'::text) WITH &&)"
